    }
    var pres = new IntersectionObserver(function (entrees) {
      if (entrees[0].isIntersecting) { pres.disconnect(); lancer(); }
    }, { rootMargin: '600px 0px' });
    pres.observe(scene);
    var bouton = el.querySelector('.mc3__rejouer');
    if (bouton) bouton.addEventListener('click', function () { if (window.gsap) jouer(inst); });
  }

  window.mc3ChezVous = function () { [].forEach.call(document.querySelectorAll('[data-mc3]'), preparer); };
  window.mc3ChezVous();
  document.addEventListener('shopify:section:load', window.mc3ChezVous);
  document.addEventListener('shopify:section:select', function (e) {
    var el = e.target && e.target.querySelector && e.target.querySelector('[data-mc3]');
    if (el && el.mc3 && window.gsap && el.classList.contains('mc3--anime')) jouer(el.mc3);
  });
  document.addEventListener('shopify:section:unload', function (e) {
    var el = e.target && e.target.querySelector && e.target.querySelector('[data-mc3]');
    if (el && el.mc3) { if (el.mc3.suivre) el.mc3.suivre(false); if (el.mc3.tl) el.mc3.tl.kill(); if (el.mc3.io) el.mc3.io.disconnect(); }
  });
})();
</script>

