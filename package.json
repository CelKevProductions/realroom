{
  "name": "realroom",
  "private": true,
  "description": "RealRoom (KPW) : photographiez votre pièce, réaménagez-la en 3D avec de vrais meubles, rendu réaliste et visite 3D.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start",
    "catalogue": "node scripts/catalogue.mjs",
    "styles:catalogue": "python3 scripts/styles_catalogue.py",
    "moteur": "node scripts/moteur.mjs",
    "test": "node --test tests/unitaires/*.test.js",
    "e2e": "python3 tests/e2e.py",
    "test:api": "node tests/api.mjs",
    "test:accueil": "python3 tests/accueil.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/oranienbaum": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "pdfjs-dist": "^5.4.624",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.25.10",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
