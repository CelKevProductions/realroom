# RealRoom : variables d'environnement (Vercel -> Settings -> Environment Variables)
# Adresse publique du site (liens, sitemap, retours de paiement)
SITE_URL=https://realroom.app
CONTACT_EMAIL=
# Sessions : 32 caractères aléatoires au moins
SESSION_SECRET=
# Base Postgres (Neon, ajoutée depuis Vercel -> Storage)
DATABASE_URL=
# Fichiers (Vercel Blob, ajouté depuis Vercel -> Storage) ; BLOB_ACCES=public si le magasin est public
BLOB_READ_WRITE_TOKEN=
BLOB_ACCES=private
# E-mails de connexion (Resend, domaine vérifié)
RESEND_API_KEY=
EMAIL_EXPEDITEUR=RealRoom <bonjour@realroom.app>
# IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODELE=claude-sonnet-5
FAL_KEY=
FAL_RESOLUTION=2K
WLT_API_KEY=
MARBLE_MODELE=marble-1.1
# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Crédits offerts à l'inscription, plafonds quotidiens
CREDITS_BIENVENUE=3
ANALYSES_PAR_JOUR=30
AMENAGEMENTS_PAR_JOUR=60
# Démonstration sans clés (jamais en production réelle) : réponses simulées
REALROOM_SIMULATION=0
