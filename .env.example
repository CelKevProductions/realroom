# RealRoom : variables d'environnement (Vercel -> Settings -> Environment Variables)
# À cocher pour « Production » seulement : une prévisualisation qui partagerait la base, les fichiers
# et SESSION_SECRET de la production donnerait accès aux vraies données.
# Adresse publique du site (liens, sitemap, retours de paiement)
SITE_URL=https://realroom.app
CONTACT_EMAIL=
# Sessions : 32 caractères aléatoires au moins
SESSION_SECRET=
# Base Postgres (Neon, ajoutée depuis Vercel -> Storage)
DATABASE_URL=
# Fichiers (Vercel Blob, ajouté depuis Vercel -> Storage) ; BLOB_ACCES=public si le magasin est public
BLOB_READ_WRITE_TOKEN=
BLOB_ACCES=private
# E-mails de connexion (Resend, domaine vérifié)
RESEND_API_KEY=
EMAIL_EXPEDITEUR=RealRoom <bonjour@realroom.app>
# IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODELE=claude-sonnet-5
# effort de réflexion de Claude (low, medium, high) : medium = bon compromis qualité / délai
CLAUDE_EFFORT=medium
FAL_KEY=
FAL_RESOLUTION=2K
WLT_API_KEY=
MARBLE_MODELE=marble-1.1
# Paiement (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Crédits offerts à l'inscription (une fois par adresse), plafonds quotidiens par compte
CREDITS_BIENVENUE=3
ANALYSES_PAR_JOUR=30
AMENAGEMENTS_PAR_JOUR=60
# Plafonds quotidiens tous comptes confondus (contre les abus et les factures surprises)
# (ils ne visent que les comptes qui n'ont encore rien acheté)
BIENVENUES_PAR_JOUR=150
BIENVENUES_PAR_DOMAINE=10
ANALYSES_ESSAI_PAR_JOUR=12
AMENAGEMENTS_ESSAI_PAR_JOUR=25
ANALYSES_GLOBALES_PAR_JOUR=600
AMENAGEMENTS_GLOBAUX_PAR_JOUR=1200
# Aménagement IA de la démo publique : clé FAL ou Anthropic + base et secret de cet environnement.
# Ne jamais recopier la base ni SESSION_SECRET de production dans une prévisualisation.
# 0 désactive les appels ; ces plafonds sont distincts des comptes et des crédits image.
DEMO_AMENAGEMENT_IA=1
DEMO_AMENAGEMENTS_PAR_JOUR=10
DEMO_AMENAGEMENTS_GLOBAUX_PAR_JOUR=30
# Services simulés de développement/test (ignoré en production ; la démo d'aménagement reste réelle)
REALROOM_SIMULATION=0
# Édition Maison Corleone (/fr/maison-corleone) : canal Headless de la boutique, Customer Account API
# (client confidentiel). Sans MC_CLIENT_ID, la connexion est annoncée « bientôt » et la démo reste ouverte.
MC_CLIENT_ID=
MC_CLIENT_SECRET=
MC_BOUTIQUE=maisoncorleone.com
MC_RENDUS_OFFERTS=2
MC_ANALYSES_MAX=6
MC_NOUVEAUX_PAR_JOUR=300
